# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://validme:validme@localhost:5432/validme
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# Origin of the Next.js app (used for CSRF + auth email links)
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=False
# Django sits behind the Next.js proxy (or a load balancer); trust its X-Forwarded-Host.
USE_X_FORWARDED_HOST=True
# Set True in production behind HTTPS termination (trusts X-Forwarded-Proto).
BEHIND_TLS_PROXY=False
# With BEHIND_TLS_PROXY=True: HSTS max-age in seconds (default one year).
SECURE_HSTS_SECONDS=31536000
# Cache for throttling + auth rate limits (use redis://localhost:6379/1 in production)
CACHE_URL=locmemcache://
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AI=30/hour

# Auth (django-allauth). Email verification: none | optional | mandatory
# Free signup credits are granted only after the email is verified (Google emails count as verified).
ACCOUNT_EMAIL_VERIFICATION=optional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ValidMe <no-reply@localhost>
# Google OAuth (leave empty to hide "Continue with Google").
# Authorized redirect URI (frontend origin, proxied to Django): http://localhost:3000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Research providers (empty = shown as "Requires connection")
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
STACKEXCHANGE_API_KEY=

# LLM (only anthropic is implemented). Without a key, AI steps report 'unavailable'.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend
# Public site origin for canonical URLs, sitemap and social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact. Leave empty until a real, monitored inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: X handle for twitter:site / twitter:creator (e.g. @validme). Leave empty until the account exists.
NEXT_PUBLIC_X_HANDLE=
# Next.js proxies /api, /_allauth and /accounts to this Django origin (same-origin cookies)
BACKEND_URL=http://localhost:8000

# MCP server (used by .mcp.json). Keep VALIDME_MOCK=1 until the backend runs.
VALIDME_API_URL=http://localhost:8000/api
VALIDME_API_KEY=
VALIDME_MOCK=1
