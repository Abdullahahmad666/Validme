# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://validme:validme@localhost:5432/validme
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# Origin of the Next.js app (used for CSRF + auth email links)
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=False
# Django sits behind the Next.js proxy (or a load balancer); trust its X-Forwarded-Host.
USE_X_FORWARDED_HOST=True
# Set True in production behind HTTPS termination (trusts X-Forwarded-Proto).
BEHIND_TLS_PROXY=False
# With BEHIND_TLS_PROXY=True: HSTS max-age in seconds (default one year).
SECURE_HSTS_SECONDS=31536000
# Cache for throttling, auth rate limits and monitoring politeness. REQUIRED to be Redis when DEBUG is off
# (the app refuses to start on locmem in production), e.g. redis://localhost:6379/1
CACHE_URL=locmemcache://
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AI=30/hour
THROTTLE_CHECKOUT=10/hour
THROTTLE_ANALYTICS=120/hour
# Creating watches / check now / from report (each can trigger page fetches)
THROTTLE_MONITORING=30/hour
# Proxies in front of Django that append X-Forwarded-For (Next.js = 1). Throttles use the IP they add.
DRF_NUM_PROXIES=1
# Global daily cap on anonymous analytics events
ANALYTICS_ANON_DAILY_CAP=20000

# Auth (django-allauth). Email verification: none | optional | mandatory
# Free signup credits are granted only after the email is verified (Google emails count as verified).
ACCOUNT_EMAIL_VERIFICATION=optional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ValidMe <no-reply@localhost>
# Google OAuth (leave empty to hide "Continue with Google").
# Authorized redirect URI (frontend origin, proxied to Django): http://localhost:3000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Research providers (empty = shown as "Requires connection")
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
STACKEXCHANGE_API_KEY=

# LLM (only anthropic is implemented). Without a key, AI steps report 'unavailable'.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Payments: Lemon Squeezy (merchant of record). Leave empty and buying credits stays closed.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Signing secret of the webhook pointed at <site>/api/billing/webhooks/lemonsqueezy (event: order_created, order_refunded)
LEMONSQUEEZY_WEBHOOK_SECRET=
# Test-mode orders are honoured only when True, live ones only when False. Defaults to DEBUG: set False in production.
LEMONSQUEEZY_TEST_MODE=True
# Credit packs on sale. Prices are set in Lemon Squeezy, never here.
CREDIT_PACKS=[]
# Example: CREDIT_PACKS=[{"id":"starter","credits":6,"variant_id":"123456"},{"id":"builder","credits":20,"variant_id":"123457"}]

# --- Jobs + logs
# Run `celery -A config beat` alongside the worker so stuck jobs are failed and refunded.
JOB_PENDING_TIMEOUT_MINUTES=15
JOB_RUNNING_TIMEOUT_MINUTES=45
# Celery stops a job 5 minutes before this (soft limit) so recovery never races a live worker.
LOG_LEVEL=INFO
# Free plan: evidence records per project visible in the explorer and search (reports are never limited)
EVIDENCE_PREVIEW_LIMIT=10

# Frontend
# Public site origin for canonical URLs, sitemap and social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact. Leave empty until a real, monitored inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: X handle for twitter:site / twitter:creator (e.g. @validme). Leave empty until the account exists.
NEXT_PUBLIC_X_HANDLE=
# Next.js proxies /api, /_allauth and /accounts to this Django origin (same-origin cookies)
BACKEND_URL=http://localhost:8000

# MCP server (used by .mcp.json). Keep VALIDME_MOCK=1 until the backend runs.
VALIDME_API_URL=http://localhost:8000/api
VALIDME_API_KEY=
VALIDME_MOCK=1

# --- Monitoring. Locally: `python manage.py monitor --loop`; production: celery beat + worker.
# Seconds between two requests to the same host, and watches claimed per scheduler cycle
MONITORING_HOST_INTERVAL=30
MONITORING_BATCH_SIZE=100
