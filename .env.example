# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://validme:validme@localhost:5432/validme
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# Origin of the Next.js app (used for CSRF + auth email links)
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=False
# Django sits behind the Next.js proxy (or a load balancer); trust its X-Forwarded-Host.
USE_X_FORWARDED_HOST=True
# Set True in production behind HTTPS termination (trusts X-Forwarded-Proto).
BEHIND_TLS_PROXY=False
# With BEHIND_TLS_PROXY=True: HSTS max-age in seconds (default one year).
SECURE_HSTS_SECONDS=31536000
# Cache for throttling, auth rate limits and monitoring politeness. REQUIRED to be Redis when DEBUG is off
# (the app refuses to start on locmem in production), e.g. redis://localhost:6379/1
CACHE_URL=locmemcache://
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AI=30/hour
THROTTLE_CHECKOUT=10/hour
THROTTLE_ANALYTICS=120/hour
# Creating watches / check now / from report (each can trigger page fetches)
THROTTLE_MONITORING=30/hour
# Proxies in front of Django that append X-Forwarded-For (Next.js = 1). Throttles use the IP they add.
DRF_NUM_PROXIES=1
# Global daily cap on anonymous analytics events
ANALYTICS_ANON_DAILY_CAP=20000

# Auth (django-allauth). Email verification: none | optional | mandatory
# Free signup credits are granted only after the email is verified (Google emails count as verified).
ACCOUNT_EMAIL_VERIFICATION=optional
# --- Email (verification + weekly digest). EMAIL_PROVIDER: console | smtp | resend
#  console: printed in the server log (local default, nothing is sent)
#  smtp:    e.g. your own Gmail for now. Turn on 2-Step Verification, create an App password at
#           https://myaccount.google.com/apppasswords and paste it below (never your Google account password).
#           Gmail sends about 500 emails a day at most, so switch to Resend before launch.
#  resend:  RESEND_API_KEY from resend.com, sending from a domain you've verified there.
EMAIL_PROVIDER=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook pointed at <site>/api/email/webhooks/resend
# (events: email.bounced, email.complained). Without it bounces are not recorded.
RESEND_WEBHOOK_SECRET=
# With Gmail the From address must be that Gmail address (or an alias you've verified in Gmail).
DEFAULT_FROM_EMAIL=ValidMe <no-reply@localhost>
# Google OAuth (leave empty to hide "Continue with Google").
# Authorized redirect URI (frontend origin, proxied to Django): http://localhost:3000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Research providers (empty = shown as "Requires connection")
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
STACKEXCHANGE_API_KEY=

# LLM (only anthropic is implemented). Without a key, AI steps report 'unavailable'.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Payments: Polar (merchant of record). Leave empty and buying credits stays closed.
# Start in the sandbox (https://sandbox.polar.sh): its token, products and webhook secret are separate from production.
# "sandbox" or "production". Defaults to sandbox when DEBUG=True, production otherwise. With DEBUG off, sandbox is
# refused at startup (test-card orders must never grant real credits) unless POLAR_ALLOW_SANDBOX=True (staging only).
POLAR_SERVER=sandbox
# Organization Access Token (Settings > Developers), with scopes: checkouts:write, products:read,
# subscriptions:read, customer_sessions:write
POLAR_ACCESS_TOKEN=
# Secret of the webhook pointed at <site>/api/billing/webhooks/polar (format: Raw). Events: order.paid,
# order.refunded, subscription.created, subscription.updated, subscription.active, subscription.canceled,
# subscription.uncanceled, subscription.revoked
POLAR_WEBHOOK_SECRET=
# Credit packs on sale: one one-time Polar product each. Prices are set in Polar, never here.
CREDIT_PACKS=[]
# Example: CREDIT_PACKS=[{"id":"starter","credits":6,"product_id":"<polar product id>"},{"id":"builder","credits":20,"product_id":"<polar product id>"}]
# Plans (subscriptions): Polar products have one interval each, so create a monthly and a yearly product per plan:
#   Founder $19/month, $190/year · Pro $39/month, $390/year (must match frontend/src/content/pricing.ts).
# monthly_credits are added on every paid order (a yearly order adds 12 months' worth).
SUBSCRIPTION_PLANS=[]
# Example: SUBSCRIPTION_PLANS=[{"id":"founder","monthly_product_id":"…","yearly_product_id":"…","monthly_credits":4},{"id":"pro","monthly_product_id":"…","yearly_product_id":"…","monthly_credits":10}]

# --- Jobs + logs
# Run `celery -A config beat` alongside the worker so stuck jobs are failed and refunded.
JOB_PENDING_TIMEOUT_MINUTES=15
JOB_RUNNING_TIMEOUT_MINUTES=45
# Celery stops a job 5 minutes before this (soft limit) so recovery never races a live worker.
LOG_LEVEL=INFO
# Free plan: evidence records per project visible in the explorer and search (reports are never limited)
EVIDENCE_PREVIEW_LIMIT=10

# Frontend
# Public site origin for canonical URLs, sitemap and social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact. Leave empty until a real, monitored inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: X handle for twitter:site / twitter:creator (e.g. @validme). Leave empty until the account exists.
NEXT_PUBLIC_X_HANDLE=
# Next.js proxies /api, /_allauth and /accounts to this Django origin (same-origin cookies)
BACKEND_URL=http://localhost:8000

# MCP server (used by .mcp.json). Keep VALIDME_MOCK=1 until the backend runs.
VALIDME_API_URL=http://localhost:8000/api
VALIDME_API_KEY=
VALIDME_MOCK=1

# --- Monitoring. Locally: `python manage.py monitor --loop`; production: celery beat + worker.
# Seconds between two requests to the same host, and watches claimed per scheduler cycle
MONITORING_HOST_INTERVAL=30
MONITORING_BATCH_SIZE=100
# AI write-ups per account per day: competitor change summaries and Radar rationales together (cost guard)
MONITORING_AI_DAILY_FREE=10
MONITORING_AI_DAILY_PAID=10
MONITORING_AI_DAILY_FOUNDER=100
MONITORING_AI_DAILY_PRO=300
# Radar "Check now" per user (re-scores stored evidence; no network)
THROTTLE_RADAR_REFRESH=6/hour

# --- Where to find your customers (Week 12)
# GitHub issues search: optional fine-grained token with NO permissions (public data only). Empty = low rate limit.
GITHUB_TOKEN=
# YouTube Data API v3 key (Google Cloud project with the API enabled; restrict the key to that API).
# Stored YouTube data is deleted after 30 days (YouTube API policy). Daily unit budget stays under the 10k quota.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_UNITS=9000
# Per account per day (~4 look-ups of 3 searches)
YOUTUBE_USER_DAILY_UNITS=1300
# DataForSEO (paid per request). Empty = keyword demand shows as unavailable.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MONTHLY_BUDGET_USD=20
# Keywords looked up per account per month, by plan
KEYWORD_LOOKUPS_FREE=10
KEYWORD_LOOKUPS_PAID=10
KEYWORD_LOOKUPS_FOUNDER=100
KEYWORD_LOOKUPS_PRO=300
THROTTLE_DISTRIBUTION=6/hour

# --- Validation Lab (Week 13): founder test pages on a SEPARATE origin
# Host that serves the public pages (exact Host header). Locally 127.0.0.1:8000 while the app uses localhost.
# Production: pages.<domain> or better a separate domain. Must differ from the app's host; never set
# SESSION_COOKIE_DOMAIN / CSRF_COOKIE_DOMAIN (the app refuses to start if you do). Add it to ALLOWED_HOSTS.
LAB_HOST=127.0.0.1:8000
LAB_ORIGIN=http://127.0.0.1:8000
# Fernet key(s) for respondents' emails, newest first. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when DEBUG is off. To rotate: put the new key first, keep the old one after it until old rows expire.
LAB_ENCRYPTION_KEYS=
# HMAC key for duplicate detection (any long random string); derived from DJANGO_SECRET_KEY if empty
LAB_HASH_KEY=
# Test pages per account, by plan
LAB_PAGES_FREE=1
LAB_PAGES_PAID=1
LAB_PAGES_FOUNDER=3
LAB_PAGES_PRO=10
LAB_SURVEYS_FREE=1
LAB_SURVEYS_PAID=1
LAB_SURVEYS_FOUNDER=3
LAB_SURVEYS_PRO=10
# Optional Cloudflare Turnstile on waitlist forms (adds Cloudflare's script to Lab pages only)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
